                <ul>
                    <?php foreach ($pages as $p): ?>
                        <li><a href="<?php echo $e($this->pageUrl($p['url_key'])) ?>" class="<?php echo $p['url_key'] === $here ? 'on' : '' ?>"><?php echo $e($p['title']) ?></a></li>
                    <?php endforeach ?>
                </ul>
