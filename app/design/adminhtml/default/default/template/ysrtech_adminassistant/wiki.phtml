    <aside class="ysrwk-nav">
        <a class="ysrwk-home" href="<?php echo $e($this->getUrl('*/*/index')) ?>"><?php echo $this->__('Wiki') ?></a>
        <form class="ysrwk-search" method="get" action="<?php echo $e($this->getUrl('*/*/index')) ?>">
            <input type="search" name="q" value="<?php echo $e($this->getQuery()) ?>" placeholder="<?php echo $this->__('Search the wiki') ?>" aria-label="<?php echo $this->__('Search the wiki') ?>" />
