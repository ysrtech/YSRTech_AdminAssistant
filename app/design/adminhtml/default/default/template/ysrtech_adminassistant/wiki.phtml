                    <h2><?php echo $e($category) ?></h2>
                    <ul>
                        <?php foreach (array_slice($pages, 0, 8) as $p): ?>
                            <li><a href="<?php echo $e($this->pageUrl($p['url_key'])) ?>"><?php echo $e($p['title']) ?></a></li>
                        <?php endforeach ?>
