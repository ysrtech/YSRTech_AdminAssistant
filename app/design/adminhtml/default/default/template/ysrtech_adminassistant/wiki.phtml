    <main class="ysrwk-main">
    <?php if ($mode === 'home'): ?>
        <h1><?php echo $this->__('Wiki') ?></h1>
        <p class="ysrwk-lede"><?php echo $this->__('How things are done in this store: OpenMage itself, and every YSRTech module. The AI Assistant reads these pages too, so what is written here is what it tells people.') ?></p>
        <div class="ysrwk-cards">
            <?php foreach ($tree as $category => $pages): ?>
