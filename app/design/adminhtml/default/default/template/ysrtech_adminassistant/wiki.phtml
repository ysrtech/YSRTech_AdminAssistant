        </div>
        <?php $recent = $wiki->recent(); if ($recent): ?>
            <h2 class="ysrwk-sub"><?php echo $this->__('Recent changes') ?></h2>
            <ul class="ysrwk-recent">
                <?php foreach ($recent as $r): ?>
                    <li><a href="<?php echo $e($this->pageUrl($r['url_key'])) ?>"><?php echo $e($r['title']) ?></a>
                        <span><?php echo $e($r['username']) ?> · <?php echo $e($this->local($r['created_at'])) ?><?php echo $r['note'] !== '' ? ' · ' . $e($r['note']) : '' ?></span></li>
